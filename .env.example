# Telegram Bot Token (получите у @BotFather)
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# ID администратора бота (ваш Telegram ID)
ADMIN_ID=YOUR_TELEGRAM_ID_HERE

# Комиссия бота в процентах (например 3 = 3%)
BOT_COMMISSION=3

# Минимальная сумма сделки в USDT
MIN_DEAL_AMOUNT=20

# USDT кошелёк бота для эскроу (TRC-20)
BOT_WALLET=YOUR_TRON_WALLET_HERE

# TronGrid API-ключ для автопроверки транзакций (бесплатно: https://www.trongrid.io/)
# Если оставить пустым — проверка TxHash отключена
TRONGRID_API_KEY=YOUR_API_KEY_HERE

# VIP-подписка
VIP_PRICE=10
VIP_DAYS=30
VIP_COMMISSION=1.5

# Авто-завершение сделки через N часов после доставки (по умолчанию 72)
AUTO_COMPLETE_HOURS=72

# Штраф за отмену сделки после оплаты (в процентах от суммы эскроу)
CANCEL_PENALTY=2

# Минимальная комиссия в USDT
MIN_COMMISSION=1
